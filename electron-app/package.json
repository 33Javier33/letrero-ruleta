{
  "name": "letrero-ruleta",
  "version": "1.176.0",
  "description": "Pantalla Ruleta Americana - Casino",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "express": "^4.18.3"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.casino.letreroruleta",
    "productName": "Letrero Ruleta",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "bundled-web",
        "to": "web"
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "portable": {
      "artifactName": "LetreroRuleta-Portable.exe"
    },
    "nsis": {
      "artifactName": "LetreroRuleta-Setup.exe",
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Letrero Ruleta"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Utility"
    },
    "publish": null
  }
}
